# The page itself must never be served from a cache. Everything it loads is versioned
# (js/core.js?v=BUILD, icons/<BUILD>/…) so those can cache hard and for ever, but if the
# page that names those versions is stale then the app runs last week's code no matter
# how many times it is deployed. A home-screen app is the worst case: it has its own
# cache and no address bar to reload from.
/
  Cache-Control: no-cache, must-revalidate
/index.html
  Cache-Control: no-cache, must-revalidate
/version.txt
  Cache-Control: no-cache, must-revalidate
/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate

/js/*
  Cache-Control: public, max-age=31536000, immutable
/icons/*
  Cache-Control: public, max-age=31536000, immutable
